<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiAndroidTest.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiAndroidTest"
    Title="MauiAndroidTest"

    Shell.TabBarBackgroundColor="#808080"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#D0D0D0">
    
    <TabBar>
        <ShellContent
            Title="Leht 1"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent
            Title="Leht 2"
            ContentTemplate="{DataTemplate local:SecondPage}"
            Route="SecondPage" />

        <ShellContent
            Title="Leht 3"
            ContentTemplate="{DataTemplate local:ThirdPage}"
            Route="ThirdPage" />

    </TabBar>

</Shell>

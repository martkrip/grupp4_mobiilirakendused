<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAndroidTest.ARPage"
    Title="AR lehekülg">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="#202A35">

        <Grid Grid.Row="0"
              BackgroundColor="#34495E">

            <Label Text="AR CAMERA"
                   TextColor="White"
                   FontSize="26"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Label Text="Scan the floor to detect a surface"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="End"
                   Margin="10,10,10,30"/>

        </Grid>

        <!-- AR controls -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20"
                             Spacing="12">

            <Label Text="Choose furniture"
                   FontSize="20"
                   FontAttributes="Bold"/>

            <HorizontalStackLayout
                HorizontalOptions="Center"
                Spacing="10">

                <Button Text="Chair"
                        Clicked="ChairClicked"/>

                <Button Text="Table"
                        Clicked="TableClicked"/>

                <Button Text="Lamp"
                        Clicked="LampClicked"/>

            </HorizontalStackLayout>

            <Button Text="Place Object"
                    BackgroundColor="#3478D4"
                    TextColor="White"
                    Clicked="PlaceClicked"/>

            <Button Text="Remove Object"
                    Clicked="RemoveClicked"/>

            <Label x:Name="StatusLabel"
                   Text="AR ready"
                   HorizontalOptions="Center"/>

        </VerticalStackLayout>

    </Grid>
</ContentPage>

